<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<TabPane tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="es.dam.ousama.controlador.DashboardControlador" prefHeight="700.0" prefWidth="1000.0">

    <Tab text="Mi Jardín">
        <BorderPane>
            <top>
                <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="elevated-1" style="-fx-padding: 10 20 10 20;">
                    <Label fx:id="lblUser" text="Usuario" styleClass="title-4" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Cerrar Sesión" onAction="#cerrarSesion" styleClass="danger, outlined"/>
                    <Button text="Salir" onAction="#salirApp" styleClass="danger"/>
                </HBox>
            </top>

            <center>
                <VBox alignment="CENTER" spacing="25.0">
                    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

                    <VBox alignment="CENTER" spacing="5">
                        <Label fx:id="lblModo" text="Modo Enfoque" styleClass="title-3, accent"/>
                        <Label fx:id="lblTiempo" text="25:00" style="-fx-font-size: 100px; -fx-font-weight: bold;" styleClass="accent"/>
                    </VBox>

                    <HBox alignment="CENTER" spacing="20" styleClass="elevated-2" style="-fx-padding: 15; -fx-background-radius: 10;" maxWidth="400">
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="Estudio (min)" styleClass="text-muted"/>
                            <Spinner fx:id="spinEstudio" prefWidth="80"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="Descanso (min)" styleClass="text-muted"/>
                            <Spinner fx:id="spinDescanso" prefWidth="80"/>
                        </VBox>
                        <Button text="Aplicar" onAction="#aplicarConfiguracion" styleClass="accent"/>
                    </HBox>

                    <VBox alignment="CENTER" spacing="10" maxWidth="350">
                        <Label text="Meta Diaria" styleClass="title-4"/>
                        <ProgressBar fx:id="progresoDiario" progress="0.0" maxWidth="Infinity" prefHeight="15" styleClass="success"/>
                    </VBox>

                    <Button fx:id="btnAccion" text="Iniciar Estudio" onAction="#gestionarTemporizador"
                            styleClass="success, large" prefWidth="250" prefHeight="55"/>
                </VBox>
            </center>

            <right>
                <VBox spacing="15" style="-fx-padding: 25; -fx-background-color: #f8f9fa;" prefWidth="280">
                    <Label text="Mis Asignaturas" styleClass="title-4"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtNuevaAsignatura" promptText="Nueva..." HBox.hgrow="ALWAYS"/>
                        <Button text="+" onAction="#agregarAsignatura" styleClass="accent"/>
                    </HBox>
                    <ListView fx:id="listaAsignaturas" VBox.vgrow="ALWAYS"/>
                    <Button text="Eliminar" onAction="#eliminarAsignatura" styleClass="danger, outlined" maxWidth="Infinity"/>
                </VBox>
            </right>
        </BorderPane>
    </Tab>

    <Tab text="Estadísticas">
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 50;">
            <Label text="Rendimiento de Estudio" styleClass="title-2"/>
            <HBox alignment="CENTER" spacing="40">
                <VBox alignment="CENTER">
                    <Label text="Total XP" styleClass="text-muted"/>
                    <Label fx:id="lblTotalXP" text="0" styleClass="title-1, success"/>
                </VBox>
            </HBox>
        </VBox>
    </Tab>
</TabPane>