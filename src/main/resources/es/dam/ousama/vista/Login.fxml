<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #e8f5e9; -fx-padding: 40;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.dam.ousama.controlador.LoginControlador">

    <Label text="Bienvenido a StudyBuddy" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>

    <TextField fx:id="txtUsuario" promptText="Nombre de usuario" maxWidth="200"/>

    <PasswordField fx:id="txtPass" promptText="Contraseña" maxWidth="200"/>

    <Button text="Acceder y Plantar" onAction="#iniciarSesion" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

    <Label fx:id="lblError" style="-fx-text-fill: red;"/>

</VBox>